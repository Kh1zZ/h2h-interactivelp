# ==============================================================================
# .gitignore for Hearts2Hearts Interactive Landing Page
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.key
*.pem
*.cert

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Build Outputs, Frameworks & Bundlers
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
dist-ssr/
.turbo/
.cache/
.parcel-cache/
.temp/
*.tsbuildinfo

# Vercel deployment artifacts
.vercel

# ------------------------------------------------------------------------------
# 4. Owner Asset Staging Area (.upl/)
# ------------------------------------------------------------------------------
# Raw staging uploads dropped by owner
.upl/

# ------------------------------------------------------------------------------
# 5. Heavy & Raw Media Assets
# ------------------------------------------------------------------------------
# Raw videos and uncompressed master audio should not bloat Git history
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.wav
*.flac
*.aiff

# Allow optimized web assets inside public/assets/
!public/assets/**

# ------------------------------------------------------------------------------
# 6. Test & Benchmark Outputs
# ------------------------------------------------------------------------------
coverage/
screenshots/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 7. OS & Local System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Editors & IDEs
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code (preserve workspace settings if shared)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 9. Local AI Agent Tooling, Skills & Artifacts
# ------------------------------------------------------------------------------
# Agent skills, rules, lockfiles, symlinks, and generated logs
.agents/
skills-lock.json
.claude/
agent/
.system_generated/
.codegraph/
.gemini/
scratch/
*.log
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 10. Markdown Documentation Files
# ------------------------------------------------------------------------------
# Ignore all markdown files except README
*.md
**/*.md
!README.md
!readme.md
!**/README.md
!**/readme.md
